  display_order        Int
  created_at           DateTime
  hackathon_id         Int
  organizer_hackathon  organizer_hackathon    @relation(fields: [hackathon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizer_scanrecord organizer_scanrecord[]

  @@unique([hackathon_id, name], map: "organizer_scancategory_hackathon_id_name_51d28d41_uniq")
  @@index([hackathon_id], map: "organizer_scancategory_hackathon_id_42a06835")
  @@index([hackathon_id, is_active], map: "sc_h_active_idx")
}

model organizer_scanrecord {
