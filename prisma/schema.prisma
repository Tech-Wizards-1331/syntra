generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../backend/db.sqlite3"
}

model account_emailaddress {
  id                        Int                         @id @default(autoincrement())
  verified                  Boolean
  primary                   Boolean
  user_id                   Int
  email                     String
  accounts_user             accounts_user               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account_emailconfirmation account_emailconfirmation[]

  @@unique([user_id, email], map: "account_emailaddress_user_id_email_987c8728_uniq")
  @@index([email], map: "account_emailaddress_email_03be32b2")
  @@index([user_id], map: "account_emailaddress_user_id_2c513194")
}

model account_emailconfirmation {
  id                   Int                  @id @default(autoincrement())
  created              DateTime
  sent                 DateTime?
  key                  String               @unique(map: "sqlite_autoindex_account_emailconfirmation_1")
  email_address_id     Int
  account_emailaddress account_emailaddress @relation(fields: [email_address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email_address_id], map: "account_emailconfirmation_email_address_id_5b7f8c58")
}

model accounts_user {
  id                             Int                              @id @default(autoincrement())
  password                       String
  last_login                     DateTime?
  is_superuser                   Boolean
  first_name                     String
  last_name                      String
  is_staff                       Boolean
  is_active                      Boolean
  date_joined                    DateTime
  email                          String                           @unique(map: "sqlite_autoindex_accounts_user_1")
  full_name                      String
  created_at                     DateTime
  updated_at                     DateTime
  is_profile_complete            Boolean
  role                           String?
  account_emailaddress           account_emailaddress[]
  accounts_user_groups           accounts_user_groups[]
  accounts_user_user_permissions accounts_user_user_permissions[]
  django_admin_log               django_admin_log[]
  organizer_hackathoncoordinator organizer_hackathoncoordinator[]
  organizer_organizerprofile     organizer_organizerprofile?
  organizer_scanrecord           organizer_scanrecord[]
  participant_participantprofile participant_participantprofile?
  participant_payment            participant_payment[]
  participant_team               participant_team[]
  participant_teamrequest        participant_teamrequest[]
  socialaccount_socialaccount    socialaccount_socialaccount[]
}

model accounts_user_groups {
  id            Int           @id @default(autoincrement())
  user_id       Int
  group_id      Int
  auth_group    auth_group    @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accounts_user accounts_user @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, group_id], map: "accounts_user_groups_user_id_group_id_59c0b32f_uniq")
  @@index([group_id], map: "accounts_user_groups_group_id_bd11a704")
  @@index([user_id], map: "accounts_user_groups_user_id_52b62117")
}

model accounts_user_user_permissions {
  id              Int             @id @default(autoincrement())
  user_id         Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accounts_user   accounts_user   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, permission_id], map: "accounts_user_user_perms_uid_pid_uniq")
  @@index([permission_id], map: "accounts_user_user_permissions_permission_id_113bb443")
  @@index([user_id], map: "accounts_user_user_permissions_user_id_e4f0a161")
}

model auth_group {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique(map: "sqlite_autoindex_auth_group_1")
  accounts_user_groups   accounts_user_groups[]
  auth_group_permissions auth_group_permissions[]
}

model auth_group_permissions {
  id              Int             @id @default(autoincrement())
  group_id        Int
  permission_id   Int
  auth_permission auth_permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_group      auth_group      @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, permission_id], map: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq")
  @@index([permission_id], map: "auth_group_permissions_permission_id_84c5c92e")
  @@index([group_id], map: "auth_group_permissions_group_id_b120cbf9")
}

model auth_permission {
  id                             Int                              @id @default(autoincrement())
  content_type_id                Int
  codename                       String
  name                           String
  accounts_user_user_permissions accounts_user_user_permissions[]
  auth_group_permissions         auth_group_permissions[]
  django_content_type            django_content_type              @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([content_type_id, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
  @@index([content_type_id], map: "auth_permission_content_type_id_2f476e4b")
}

model django_admin_log {
  id                  Int                              @id @default(autoincrement())
  object_id           String?
  object_repr         String
  action_flag         Int
  change_message      String
  content_type_id     Int?
  user_id             Int
  action_time         DateTime
  accounts_user       accounts_user                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  django_content_type django_content_type?             @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "django_admin_log_user_id_c564eba6")
  @@index([content_type_id], map: "django_admin_log_content_type_id_c4bce8eb")
}

model django_celery_beat_clockedschedule {
  id                              Int                               @id @default(autoincrement())
  clocked_time                    DateTime
  django_celery_beat_periodictask django_celery_beat_periodictask[]
}

model django_celery_beat_crontabschedule {
  id                              Int                               @id @default(autoincrement())
  minute                          String
  hour                            String
  day_of_week                     String
  day_of_month                    String
  month_of_year                   String
  timezone                        String
  django_celery_beat_periodictask django_celery_beat_periodictask[]
}

model django_celery_beat_intervalschedule {
  id                              Int                               @id @default(autoincrement())
  every                           Int
  period                          String
  django_celery_beat_periodictask django_celery_beat_periodictask[]
}

model django_celery_beat_periodictask {
  id                                  Int                                  @id @default(autoincrement())
  name                                String                               @unique(map: "sqlite_autoindex_django_celery_beat_periodictask_1")
  task                                String
  args                                String
  kwargs                              String
  queue                               String?
  exchange                            String?
  routing_key                         String?
  expires                             DateTime?
  enabled                             Boolean
  last_run_at                         DateTime?
  total_run_count                     Int
  date_changed                        DateTime
  description                         String
  crontab_id                          Int?
  interval_id                         Int?
  solar_id                            Int?
  one_off                             Boolean
  start_time                          DateTime?
  priority                            Int?
  headers                             String
  clocked_id                          Int?
  expire_seconds                      Int?
  django_celery_beat_clockedschedule  django_celery_beat_clockedschedule?  @relation(fields: [clocked_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  django_celery_beat_solarschedule    django_celery_beat_solarschedule?    @relation(fields: [solar_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  django_celery_beat_intervalschedule django_celery_beat_intervalschedule? @relation(fields: [interval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  django_celery_beat_crontabschedule  django_celery_beat_crontabschedule?  @relation(fields: [crontab_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clocked_id], map: "django_celery_beat_periodictask_clocked_id_47a69f82")
  @@index([solar_id], map: "django_celery_beat_periodictask_solar_id_a87ce72c")
  @@index([interval_id], map: "django_celery_beat_periodictask_interval_id_a8ca27da")
  @@index([crontab_id], map: "django_celery_beat_periodictask_crontab_id_d3cba168")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model django_celery_beat_periodictasks {
  ident       Int @id
  last_update DateTime

  @@ignore
}

model django_celery_beat_solarschedule {
  id                              Int                               @id @default(autoincrement())
  event                           String
  latitude                        Decimal
  longitude                       Decimal
  django_celery_beat_periodictask django_celery_beat_periodictask[]

  @@unique([event, latitude, longitude], map: "celery_solarschedule_evt_lat_long_uniq")
}

model django_content_type {
  id               Int                @id @default(autoincrement())
  app_label        String
  model            String
  auth_permission  auth_permission[]
  django_admin_log django_admin_log[]

  @@unique([app_label, model], map: "django_content_type_app_label_model_76bd3d3b_uniq")
}

model django_migrations {
  id      Int      @id @default(autoincrement())
  app     String
  name    String
  applied DateTime
}

model django_session {
  session_key  String   @id
  session_data String
  expire_date  DateTime

  @@index([expire_date], map: "django_session_expire_date_a5c62663")
}

model django_site {
  id                            Int                             @id @default(autoincrement())
  name                          String
  domain                        String                          @unique(map: "sqlite_autoindex_django_site_1")
  socialaccount_socialapp_sites socialaccount_socialapp_sites[]
}

model organizer_hackathon {
  id                             Int                              @id @default(autoincrement())
  name                           String
  description                    String?
  start_date                     DateTime
  end_date                       DateTime
  registration_deadline          DateTime
  status                         String
  min_team_size                  Int
  max_team_size                  Int
  created_at                     DateTime
  updated_at                     DateTime
  organizer_id                   Int
  room_configuration             String?
  seating_allocation             String?
  fee_amount                     Decimal?
  fee_type                       String?
  is_paid                        Boolean
  organizer_organizerprofile     organizer_organizerprofile       @relation(fields: [organizer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizer_hackathoncoordinator organizer_hackathoncoordinator[]
  organizer_problemstatement     organizer_problemstatement[]
  organizer_scancategory         organizer_scancategory[]
  participant_team               participant_team[]

  @@index([organizer_id], map: "organizer_hackathon_organizer_id_1ad8afb1")
  @@index([status], map: "organizer_hackathon_status_f6762e83")
}

model organizer_hackathoncoordinator {
  id                  Int                 @id @default(autoincrement())
  is_active           Boolean
  created_at          DateTime
  hackathon_id        Int
  user_id             Int
  accounts_user       accounts_user       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizer_hackathon organizer_hackathon @relation(fields: [hackathon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([hackathon_id, user_id], map: "organizer_hackathoncoord_hid_uid_uniq")
  @@index([hackathon_id, user_id, is_active], map: "coord_h_u_active_idx")
  @@index([user_id], map: "organizer_hackathoncoordinator_user_id_14c94e16")
  @@index([hackathon_id], map: "organizer_hackathoncoordinator_hackathon_id_91aab097")
}

model organizer_organizerprofile {
  id                  Int                   @id @default(autoincrement())
  organization_name   String
  website             String?
  logo                String?
  created_at          DateTime
  updated_at          DateTime
  user_id             Int                @unique(map: "sqlite_autoindex_organizer_organizerprofile_1")
  organizer_hackathon organizer_hackathon[]
  accounts_user       accounts_user         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
