# Database connection strings (Supabase)
# Transactional connection pooler (Port 6543) - Recommended for Vercel serverless functions
DATABASE_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) - Required for running migrations
DIRECT_URL="postgresql://postgres.[your-project-id]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth Configuration
AUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"
# Canonical URL of the application (Vercel deployment URL or localhost in dev)
AUTH_URL="http://localhost:3000"

# Social Authentication Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Third-party Integrations
CLOUDINARY_URL="cloudinary://[api-key]:[api-secret]@[cloud-name]"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxx"

# SMTP Email Notifications (nodemailer)
# For Gmail: host=smtp.gmail.com, port=587, user=gmail, password=AppPassword
# For Custom Domain/Resend: host=smtp.resend.com, port=465, user=resend, password=ApiKey
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password-16-characters"
SMTP_FROM='"Syntra Invite" <your-email@gmail.com>'

